# Local frontend settings. The Supabase anon/publishable key is public; never use a
# Supabase service-role or secret key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Leave empty in local dev to use the Vite proxy to http://127.0.0.1:8001
VITE_API_BASE_URL=

# The Admin knowledge panel is hidden in production builds by default. Set this to
# "true" only once Supabase Auth is fully configured and admin access is intended.
# (It is always visible during `npm run dev`.)
VITE_ENABLE_ADMIN=
