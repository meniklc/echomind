# Local frontend settings. The Supabase anon/publishable key is public; never use a
# Supabase service-role or secret key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Leave empty in local dev to use the Vite proxy to http://127.0.0.1:8000
VITE_API_BASE_URL=
