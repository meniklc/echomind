# ==============================================================================
# EchoMind Environment Configuration Template
# For local development: copy to backend/.env (port 8001)
# For production: set in Render (backend) and Vercel (frontend)
# ==============================================================================

# Local backend port: 8001 (do NOT change to 8000)
PORT=8001

# Allowed CORS origins (comma-separated). Include your Vercel deployment URL.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-echomind.vercel.app

# Groq LLM API Configuration (OpenAI-compatible)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=30.0

# Text-to-Speech (Edge TTS Neural Voices - 100% Free, No GPU Required)
# Recommended voices: en-US-JennyNeural, en-US-GuyNeural, en-IN-PrabhatNeural, en-IN-NeerjaNeural
TTS_VOICE=en-US-JennyNeural
TTS_RATE=+0%
TTS_MAX_CHARS=1200
TTS_TIMEOUT_SECONDS=45.0

# Supabase Auth (backend verification and frontend sign-in)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Optional backend-only signing secret for legacy HS256 projects.
SUPABASE_JWT_SECRET=
OWNER_USER_IDS=your-owner-user-uuid

# Existing Supabase PostgREST adapter setting (backend-only; no storage migration here).
SUPABASE_KEY=your-backend-supabase-key

# Frontend Vite environment (publishable anon key only; never use service-role/secret keys)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
# VITE_API_BASE_URL=https://echomind-backend.onrender.com
