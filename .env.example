# Shared example — copy values into backend/.env for local development.

# Frontend origin(s) allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM (OpenAI-compatible). Leave empty to use grounded fact-retrieval mode (no external model).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_SECONDS=30

# TTS (edge-tts neural voice)
TTS_VOICE=en-US-JennyNeural
TTS_RATE=+0%
TTS_MAX_CHARS=1200
TTS_TIMEOUT_SECONDS=45
