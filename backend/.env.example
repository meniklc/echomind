# Copy to backend/.env and fill in values as needed.

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenAI-compatible LLM. Empty LLM_API_KEY => grounded fact-retrieval mode (no paid API required).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Use a model currently served by your provider. Fallbacks are tried if the primary is rejected.
LLM_MODEL=openai/gpt-oss-20b
LLM_FALLBACK_MODELS=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=800

TTS_VOICE=en-US-JennyNeural
TTS_RATE=+0%
TTS_MAX_CHARS=1200
TTS_TIMEOUT_SECONDS=45

# Supabase Auth token verification (backend only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Set only for legacy HS256 projects; keep this secret on the backend.
SUPABASE_JWT_SECRET=
OWNER_USER_IDS=your-owner-user-uuid
